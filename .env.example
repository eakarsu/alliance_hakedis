DATABASE_URL=postgresql://hakedis_app:replace-me@127.0.0.1:5432/hakedis
HAKEDIS_JWT_SECRET=replace-with-at-least-32-random-characters
BACKEND_PORT=3001
CORS_ORIGINS=https://hakedis.example.com

# Optional typed providers. Endpoints must use HTTPS in normal operation.
HAKEDIS_PAYMENT_PROVIDER_URL=https://payments.example.com/v1
HAKEDIS_PAYMENT_PROVIDER_TOKEN=replace-me
HAKEDIS_NOTIFICATION_PROVIDER_URL=https://notify.example.com/v1
HAKEDIS_NOTIFICATION_PROVIDER_TOKEN=replace-me
# Local-only demo autofill. The ignored .env must provide one complete
# DEMO_*, SEED_ADMIN_*, ADMIN_*, or DEFAULT_* email/password pair.
ENABLE_DEMO_CREDENTIAL_AUTOFILL=false
